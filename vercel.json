{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__p=api/:path*"
    },
    {
      "source": "/mcp/:path*",
      "destination": "/api/index?__p=mcp/:path*"
    },
    {
      "source": "/mcp",
      "destination": "/api/index?__p=mcp"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/fonts/v1/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "outputDirectory": "public",
  "buildCommand": "node scripts/test.mjs run google spaces workstream assistant briefing-style search paging fonts"
}
