# 로컬 실행 시 참고용. Vercel 에서는 Project Settings → Environment Variables 에 입력하세요.
ICLOUD_USERNAME=you@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
APP_PASSWORD=웹앱-로그인-비밀번호
MCP_TOKEN=30자-이상-아무-문자열
TIMEZONE=Asia/Seoul
HIDDEN_CALENDARS=
# 연결한 AI: claude 또는 chatgpt. 배포별로 고정합니다. 앱에서는 테마만 변경할 수 있습니다.
ASSISTANT=claude
